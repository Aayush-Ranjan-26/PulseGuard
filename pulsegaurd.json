        "options": {}
      },
      "id": "065bf332-9769-46b7-85e9-1d0d59fac0d4",
      "name": "Split Services",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -656,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const service = $json;\nconst start = Date.now();\nlet statusCode = 0;\n\ntry {\n  const res = await this.helpers.httpRequest({\n    method: 'GET',\n    url: service.url,\n    timeout: 10000,\n    returnFullResponse: true,\n    ignoreHttpStatusErrors: true,\n  });\n  statusCode = res.statusCode;\n} catch (e) {\n  statusCode = 0; // timeout / DNS fail / connection refused\n}\n\nconst responseTimeMs = Date.now() - start;\n\nreturn [{\n  json: {\n    service_name: service.name,\n    status_code: statusCode,\n    response_time_ms: responseTimeMs,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "1cd76716-0251-4a28-9307-b965a3666c93",
      "name": "Check Service (HTTP + Timing)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -432,
        144
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $json.status_code }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            },
            {
              "id": "cond-002",
              "leftValue": "={{ $json.response_time_ms }}",
              "rightValue": 2000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "2c8b11fd-f93e-4ce4-b4d4-80f0198cc360",
      "name": "IF Down or Slow",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -208,
        144
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL || 'https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"🚨 **ALERT:** {{ $json.service_name }} is DOWN or SLOW. Status: {{ $json.status_code }}. Response: {{ $json.response_time_ms }} ms. Time: {{ $json.timestamp }}\"\n}",
