              "name": "services",
              "value": "=[\n  { \"name\": \"Plex\", \"url\": \"https://watch.plex.tv/\" },\n  { \"name\": \"NAS\", \"url\": \"https://nas.com/\" },\n  { \"name\": \"Home Assistant\", \"url\": \"https://www.home-assistant.io/\" }\n]",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "106bd12c-7f9f-4779-accd-a8a0240d1a31",
      "name": "Define Services",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -880,
        144
      ]
    },
    {
      "parameters": {
